{
  "name": "storage-minis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit --project tsconfig.json",
    "check": "turbo run typecheck typecheck:root lint format:check test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "format:check": "prettier --check .prettierrc.json \"*.{json,mjs,mts,yaml,yml}\" \"{apps,packages}/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json,yaml,yml,css,html}\"",
    "format": "prettier --write .prettierrc.json \"*.{json,mjs,mts,yaml,yml}\" \"{apps,packages}/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json,yaml,yml,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "build": "turbo run build",
    "start": "turbo run start --filter=@storage-minis/api",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "test:db": "turbo run test:integration",
    "test:api": "turbo run test:process --filter=@storage-minis/api",
    "dev": "turbo run dev",
    "db:up": "docker compose --env-file .env.development up --detach --wait --wait-timeout 60 postgres postgres_test",
    "db:down": "docker compose --env-file .env.development stop postgres postgres_test",
    "db:psql": "docker compose --env-file .env.development exec postgres psql -U storage_minis_owner -d storage_minis_dev",
    "db:reset": "docker compose --env-file .env.development down --volumes",
    "stack:up": "docker compose --project-name storage-minis-stack --file compose.yaml --file compose.stack.yaml --env-file .env.test run --rm --build migrate && docker compose --project-name storage-minis-stack --file compose.yaml --file compose.stack.yaml --env-file .env.test up --detach --wait --wait-timeout 60",
    "stack:down": "docker compose --project-name storage-minis-stack --file compose.yaml --file compose.stack.yaml --env-file .env.test down --volumes --remove-orphans",
    "test:stack": "pnpm --filter @storage-minis/api test:stack"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
