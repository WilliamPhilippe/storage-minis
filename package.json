{
  "name": "storage-minis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit --project tsconfig.json",
    "check": "turbo run typecheck typecheck:root lint format:check test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "format:check": "prettier --check .prettierrc.json \"*.{json,mjs,mts,yaml,yml}\" \"{apps,packages}/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json,yaml,yml,css,html}\"",
    "format": "prettier --write .prettierrc.json \"*.{json,mjs,mts,yaml,yml}\" \"{apps,packages}/**/*.{ts,tsx,js,mjs,cjs,mts,cts,json,yaml,yml,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "build": "turbo run build",
    "db:check": "turbo run db:check",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "test:db": "turbo run test:integration",
    "docker:build": "docker compose --env-file .env.compose --file compose.yaml build tooling",
    "docker:init": "docker compose --env-file .env.compose --file compose.yaml run --rm --no-deps tooling-init",
    "docker:up": "./scripts/database.sh up dev",
    "docker:up:test": "./scripts/database.sh up test",
    "docker:stop": "docker compose --env-file .env.compose --file compose.yaml --profile '*' stop --timeout 10",
    "docker:stop:test": "docker compose --env-file .env.compose --file compose.yaml stop --timeout 10 postgres_test",
    "docker:prune": "docker compose --env-file .env.compose --file compose.yaml --profile '*' down --remove-orphans --timeout 10",
    "docker:prune:volumes": "./scripts/reset-volumes.sh",
    "docker:ps": "docker compose --env-file .env.compose --file compose.yaml --profile '*' ps --all",
    "docker:logs": "docker compose --env-file .env.compose --file compose.yaml logs --follow postgres",
    "docker:setup": "./scripts/configure-local.sh && pnpm docker:build && docker compose --env-file .env.compose --file compose.yaml pull postgres && pnpm docker:init && ./scripts/tooling.sh run pnpm install --frozen-lockfile && pnpm docker:up",
    "docker:migrate": "./scripts/tooling.sh run-db dev pnpm db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
