// storage-minis database design, draft 1 — reviewed 2026-10-23.
// Sources: entity-map-v0.8.md and dated schema-review logs. Review guide: design.md.
// This is a visual proposal, not an approved physical schema or a migration.
// Money uses integer BRL centavos; actual occurrence timestamps use timestamptz.
// Key generation, column names, optionality beyond explicit requirements, and table boundaries
// are proposals. All candidate table shapes were rejected and are absent.

Project storage_minis_draft_1 {
  database_type: 'PostgreSQL'
  Note: '''
    Visual schema draft with the 2026-10-23 owner field review applied; see design.md.
    E-IDs in notes preserve traceability; see design.md for all 38 mapped entries.
    Product and User are global. Operational records belong to an Organization.
    Monetary values are integer BRL centavos. Integer keys are separate from readable unit IDs.
    Timestamp instants use timestamptz; reporting uses UTC and display is visitor-local.
    Some older shapes still await October 22 propagation; see design.md.
    Remaining role/transition/enforcement and T01/T02/T03/T05 contracts are unresolved.
    Partial uniqueness, aggregate reconciliation, authorization, history validation,
    and atomic/concurrent operations need enforcement beyond these diagram references.
  '''
}

Enum supplier_type {
  person
  business
}

Enum inventory_status {
  china
  brasil
  eua
  bolivia
  shipped
  received
}

Enum sale_status {
  unapproved
  available
  held
  collection
}

Enum purchase_lifecycle {
  open
  completed
  canceled
}

Enum expense_completeness {
  unknown
  confirmed_zero
  accounted_for
}

Enum acquisition_allocation_method {
  proportional_to_value
  equal_per_unit
  manual
}

Enum business_event_scope {
  organization
  global_product
}

Enum customer_settlement_outcome {
  refund
  reassignment
  retained_income
}

Enum supplier_settlement_outcome {
  refund
  reassignment
  loss
}

Enum membership_role {
  owner
  editor
  viewer
}

Enum user_role {
  global_admin
  editor
  user
}

// Global User roles and Organization-scoped Membership roles are distinct.

Table organizations [headercolor: #4B6B9E] {
  id integer [pk, not null]
  name text [not null, note: 'Proposed display field for the Organization.']
  created_at timestamptz [not null]

  Note: 'E01 | REQ-004; ORG-001-002, ORG-008-009. One implicit collection through InventoryItem membership. No Product ownership.'
}

Table users [headercolor: #4B6B9E] {
  id integer [pk, not null]
  firebase_uid text [not null, note: 'External Google-only Firebase identity. Uniqueness remains required, with its supporting index deferred; T02 owns bootstrap and recovery.']
  email text [note: 'Identity profile; no email uniqueness or first-login administrator rule is implied.']
  display_name text
  role user_role [not null, default: 'user', note: 'Global role. Capability mapping and bootstrap remain T02; this role alone does not grant Organization access.']
  created_at timestamptz [not null]

  Note: 'E02 | ORG-003-005; TECH-001. Global application identity. Authentication tokens and session persistence are T02 implementation work.'
}

Table memberships [headercolor: #4B6B9E] {
  id integer [pk, not null]
  organization_id integer [not null]
  user_id integer [not null]
  granted_at timestamptz [not null]
  role membership_role [not null, note: 'Organization role: owner, editor or viewer. Revocation deletes this Membership; preserve the action in shared audit.']

  indexes { organization_id }

  Note: 'E03 | ORG-003-005, ORG-008. One current User-Organization association. Revocation deletes the row; prior grants/revocations remain in audit independently of that row. Role capabilities remain T02.'
}

// Global catalog values and Organization-owned physical units.

Table products [headercolor: #387D70] {
  id integer [pk, not null]
  name text [not null]
  sku text [not null, note: 'Required and deliberately NONUNIQUE. Not an automatic import/deduplication key.']
  brand text [not null, note: 'E43: embedded required brand value; no Brand entity.']
  description text
  images text[] [note: 'E42: list of image URL/storage-reference strings. Hosting and public presentation remain D04/T04.']
  is_chase boolean [not null, default: false, note: 'Shared Product variant attribute.']
  registration_event_id integer [not null, note: 'Global registration provenance; the event may retain Organization context without Product ownership.']

  Note: '''
    E04 | PRO-001-013. Global Product: no organization_id, unit condition, price,
    cost, collection pointer, or private notes. Every Organization can reuse it.
    Global edit authority/current historical labels are approved; enforcement remains D07/T01/T02.
    D04 defines the public field allowlist; internal sharing does not publish all fields.
  '''
}

Table inventory_items [headercolor: #387D70] {
  id integer [pk, not null, note: 'Permanent internal Item key; never reused.']
  inventoryId text [not null, note: 'Short readable box identifier assigned automatically at Purchase registration, including preorders. Immutable, Organization-unique and never reused; gaps allowed. Proposed compact format: uppercase base36, no prefix/padding (1, Z, 10). T01 must enforce uniqueness and concurrent generation.']
  organization_id integer [not null]
  product_id integer [not null]
  purchase_id integer [not null, note: 'Scope key constrained to the originating PurchaseItem, including marked opening Purchases.']
  purchase_item_id integer [not null, note: 'One line in the originating ordinary or marked opening Purchase.']
  merchandise_cost integer [note: 'Exact unit share of PurchaseItem merchandise total. Required for ordinary purchases by cross-record enforcement; unknown opening costs remain null and need T05 review.']
  sealed boolean [note: 'True: sealed; false: open; null: unknown or not applicable. Import mappings must not turn missing evidence into false.']
  damaged boolean [note: 'True: damaged; false: undamaged; null: unknown or not applicable. Damage alone does not select sale eligibility.']
  damage_description text
  private_notes text
  asking_price integer [note: 'Current asking price; never changes historical agreed SaleItem prices.']
  status inventory_status [not null, note: 'Physical progress: china, brasil, eua, bolivia, shipped, received. No country default; required at registration. Outgoing Sale dispatch, removal and Loss remain distinct source facts.']
  sale_status sale_status [not null, default: 'unapproved', note: 'Mutually exclusive: unapproved, available, held, collection. Only available can be eligible for sale, subject to physical/funding/cost/commitment rules. Collection membership is sale_status = collection; at most one per Organization/Product. Leaving available/collection never unlocks finalized costs.']
  first_received_event_id integer [note: 'Preserved forever. Purchase cancellation checks ever-received history, not current possession.']
  first_sale_approval_event_id integer
  removed_event_id integer [note: 'Soft removal retains this row and identity. Ordinary removal requires Open Purchase, no receipt and zero allocated supplier payment.']
  acquisition_expense_completeness expense_completeness [not null, default: 'unknown', note: 'Completeness of applicable additional expenses. Full cost completeness also needs a known merchandise amount. Explicit complete/settled collection-unit finalization is approved independently of sale eligibility.']
  finalized_acquisition_cost integer [note: 'E44: proposed embedded snapshot of authoritative acquisition sources, not a manually editable balance.']
  cost_finalized_event_id integer [note: 'Permanent lock at first sale approval or explicit eligible collection-unit cost finalization; removing approval/membership never unlocks costs.']
  created_event_id integer [not null]

  indexes { organization_id }

  checks {
    `((finalized_acquisition_cost IS NULL) = (cost_finalized_event_id IS NULL))` [name: 'cost_snapshot_has_event']
  }

  Note: '''
    E05; embedded E44 | REQ-009, REQ-012; INV-001-031; COL-001-009; PUR-023.
    Commitment/payment state is derived through SaleItems and allocations, not a
    single editable stock status. Damage does not change eligibility automatically.
    Collection and held statuses exclude sale and cannot coexist with available.
    Collection membership is sale_status = collection; membership is optional.
    All units of one PurchaseItem share one Product, including retained removed units.
    Source allocations are preserved/locked with first approval. E44 may become a
    versioned snapshot table only if the reviewed correction design requires it (D06).
    Opening units use marked month/Supplier-grouped Purchases with reviewed evidence.
    Ordinary merchandise costs are required; missing legacy facts remain explicit.
  '''
}

// Purchasing, item-level funding, and actual supplier refunds.

Table suppliers [headercolor: #97703C] {
  id integer [pk, not null]
  organization_id integer [not null]
  name text [not null]
  phone text
  type supplier_type
  is_unknown boolean [not null, default: false, note: 'Organization-owned placeholder used only when an imported unit has no known Supplier. T01 must enforce one placeholder per Organization; do not invent contact/type facts.']
  created_event_id integer [not null]

  indexes { organization_id }
  checks {
    `(is_unknown OR (phone IS NOT NULL AND type IS NOT NULL))` [name: 'known_supplier_has_contact_and_type']
    `(NOT is_unknown OR (phone IS NULL AND type IS NULL))` [name: 'unknown_supplier_has_no_fabricated_details']
  }
  Note: 'E06 | SUP-001-012. Known Suppliers require name/phone/type; the import placeholder has only its identifying name. Supplier balances and refund obligations are derived; no supplier-credit field or entity.'
}

Table purchases [headercolor: #97703C] {
  id integer [pk, not null]
  organization_id integer [not null]
  supplier_id integer [not null]
  ordered_on timestamptz [not null, note: 'Actual occurrence for ordinary Purchases. For month-grouped openings, use the owner-approved convention: second day of opening_month, normalized to 00:00 UTC. This is a conventional import timestamp, not evidence of an actual historical day/time.']
  is_opening boolean [not null, default: false, note: 'E39: marked legacy acquisition, grouped once per Organization, Supplier and purchase year/month. Not a new historical cash transaction.']
  opening_month varchar(7) [note: 'Known source purchase month in YYYY-MM form, required only for opening Purchases. Preserve month precision alongside the conventional second-day timestamp.']
  opening_source_description text
  opening_evidence jsonb [note: 'Reviewed source provenance and assumptions; missing costs/payments remain unknown; the second-day timestamp is an explicitly approved convention.']
  lifecycle purchase_lifecycle [not null, default: 'open']
  expense_completeness expense_completeness [not null, default: 'unknown']
  expenses_confirmed_event_id integer [note: 'Explicit accounting/zero confirmation for this Purchase only, considering shared allocations.']
  incoming_shipping_notes text [note: 'Proposed descriptive field for PUR-010 incoming information; no package/carrier hierarchy.']
  completed_event_id integer
  canceled_event_id integer
  created_event_id integer [not null]

  indexes { organization_id }

  checks {
    `((opening_month IS NOT NULL) = is_opening)` [name: 'opening_purchase_has_month']
    `(opening_month IS NULL OR (opening_month ~ '^[0-9]{4}-(0[1-9]|1[0-2])$' AND left(opening_month, 4) <> '0000'))` [name: 'valid_opening_month']
    `(NOT is_opening OR ordered_on = (opening_month || '-02T00:00:00Z')::timestamptz)` [name: 'opening_purchase_uses_second_day']
  }

  Note: '''
    E07; E39 opening treatment | PUR-001-015, PUR-028-041, PUR-045-049.
    Opening groups use one known Supplier or the Organization's unknown Supplier.
    T01 must enforce one opening group per Organization/Supplier/year-month under concurrency.
    Second-day midnight-UTC occurrence is an approved import convention, not an actual-time claim.
    Historical funding/receipt evidence is reviewed under T05, never manufactured.
    Ordinary payment and receipt progress are derived per active unit, separately from lifecycle. Completion requires all
    remaining units received and applicable expenses accounted for. Completed
    Purchases reject ordinary edits. Any historical receipt forbids cancellation.
    Shared expenses have independent identities and settlement; never cascade-delete them.
  '''
}

Table purchase_items [headercolor: #97703C] {
  id integer [pk, not null]
  organization_id integer [not null]
  purchase_id integer [not null]
  ordered_quantity integer [not null, note: 'Registered quantity with dated amendments preserved. Active quantity derives from retained InventoryItems.']
  merchandise_total integer [note: 'Source line total, required for ordinary Purchases by cross-record enforcement. Unknown opening costs remain null for T05 review. Deterministic shares use exact centavo allocation.']
  created_event_id integer [not null]

  indexes { organization_id }
  checks { `ordered_quantity > 0` [name: 'positive_ordered_quantity'] }

  Note: 'E08 | PUR-002-007; INV-006. No product_id: reach one shared Product through all generated InventoryItems. Preserve removed identities and original line facts in shared history.'
}

Table supplier_payments [headercolor: #97703C] {
  id integer [pk, not null]
  organization_id integer [not null]
  supplier_id integer [not null]
  amount integer [not null]
  paid_on timestamptz [not null]
  method text [not null]
  created_event_id integer [not null]

  indexes { organization_id }
  Note: 'E09 | SUP-010-011; PUR-042-044. Actual outgoing merchandise cash. Fully allocated at entry to individual units of this Supplier, possibly across Purchases. Corrections preserve original cash and dated changes.'
}

Table supplier_payment_allocations [headercolor: #97703C] {
  id integer [pk, not null]
  organization_id integer [not null]
  supplier_id integer [not null, note: 'Scope key matching both Payment and the originating Purchase.']
  supplier_payment_id integer [not null]
  purchase_id integer [not null, note: 'Scope key matching the InventoryItem acquisition path.']
  inventory_item_id integer [not null]
  amount integer [not null, note: 'Preserved original allocation amount; dated release/reclassification consequences remain queryable.']
  created_event_id integer [not null]

  indexes { organization_id }
  Note: 'E10 | PUR-034, PUR-042-044. Unit-level funding, not merely a PurchaseItem allocation. Effective funding derives from original allocations and dated resolutions/corrections; no cash is created by reassignment.'
}

Table supplier_refunds [headercolor: #97703C] {
  id integer [pk, not null]
  organization_id integer [not null]
  supplier_id integer [not null]
  settlement_id integer [not null, note: 'Approved supplier-side settlement; original funding portions are traced through its source allocations.']
  amount integer [not null]
  received_on timestamptz [not null]
  method text [not null]
  related_loss_id integer [note: 'Optional original Loss provenance for actual money received later; avoid duplicating its economic adjustment.']
  created_event_id integer [not null]

  indexes { organization_id }
  Note: 'E11 | SUP-009, SUP-011-012; PUR-029-033. Actual cash received only. An expected refund is represented by the source-linked settlement obligation until received or explicitly resolved as Loss.'
}

// Expenses: one cost source, dated partial cash payments, and selected-unit cost allocations.

Table purchase_expenses [headercolor: #A46D46] {
  id integer [pk, not null]
  organization_id integer [not null]
  amount integer [not null, note: 'Expense value, whether paid or unpaid; count it once as an expense.']
  incurred_on timestamptz [not null]
  category text [not null]
  context text
  allocation_method acquisition_allocation_method [not null, default: 'proportional_to_value']
  settled_amount integer [not null, default: 0, note: 'E15: cumulative amount paid, reconciled to this expense payment rows; 0 while unpaid, between 0 and amount while partial, equal to amount when fully paid. Derived cache, never manually edited.']
  settled_on timestamptz [note: 'Completion timestamp only: null until fully paid, then the actual time of the payment completing this expense. Each installment retains its own date/method below.']
  created_event_id integer [not null]

  indexes { organization_id }
  checks {
    `amount > 0` [name: 'positive_purchase_expense']
    `(settled_amount >= 0 AND settled_amount <= amount)` [name: 'purchase_expense_payment_bounds']
    `((settled_on IS NOT NULL) = (settled_amount = amount))` [name: 'purchase_expense_fully_paid_timestamp']
  }

  Note: '''
    E13; linked E15 | PUR-016-024, PUR-035, PUR-047-049; FIN-001-002.
    One Organization-owned expense can concern several Purchases. Amount and cash
    are counted once. Partial payments keep their own dates/methods. Allocate only to selected units; linked Purchases must match
    those units. No Purchase owner, header allocation, estimate, or automatic redistribution.
    Changes preserve completed-Purchase facts and finalized unit costs across all links.
  '''
}


Table purchase_expense_payments [headercolor: #A46D46] {
  id integer [pk, not null]
  organization_id integer [not null]
  purchase_expense_id integer [not null]
  amount integer [not null, note: 'Actual outgoing installment in integer centavos, counted once as cash. Not another expense or cost allocation.']
  paid_on timestamptz [not null, note: 'Actual cash occurrence, independent of expense incurrence, final completion and recording time.']
  method text [not null]
  created_event_id integer [not null]

  indexes { organization_id }
  checks { `amount > 0` [name: 'positive_purchase_expense_payment'] }
  Note: 'E15 purchase side | One expense may have many dated payments. T01 must atomically record payment/audit, reconcile settled_amount to authoritative payments, reject overpayment/cross-Organization references and serialize competing payments. Preserve every installment; never replace an earlier payment with a later cumulative value.'
}

Table acquisition_expense_allocations [headercolor: #A46D46] {
  id integer [pk, not null]
  organization_id integer [not null]
  purchase_expense_id integer [not null]
  purchase_id integer [not null, note: 'Scope key constrained to the target Item acquisition. Derive PurchaseExpense-Purchase links exclusively from unit allocations.']
  inventory_item_id integer [not null]
  amount integer [not null]
  created_event_id integer [not null]

  indexes { organization_id }
  Note: 'E14 | PUR-018-021, PUR-024, PUR-048-049; INV-011. One current cost allocation per expense/unit pair. Preserve prior amount/method/source versions in shared history. Sum selected unit allocations to the expense once, including deterministic T03 remainders.'
}

Table sale_expenses [headercolor: #A46D46] {
  id integer [pk, not null]
  organization_id integer [not null]
  sale_id integer [not null]
  amount integer [not null, note: 'Expense value, whether paid or unpaid; count it once as an expense.']
  incurred_on timestamptz [not null]
  category text [not null]
  context text
  settled_amount integer [not null, default: 0, note: 'E15: cumulative amount paid, reconciled to this expense payment rows; 0 while unpaid, between 0 and amount while partial, equal to amount when fully paid. Derived cache, never manually edited.']
  settled_on timestamptz [note: 'Completion timestamp only: null until fully paid, then the actual time of the payment completing this expense. Each installment retains its own date/method below.']
  created_event_id integer [not null]

  indexes { organization_id }
  checks {
    `amount > 0` [name: 'positive_sale_expense']
    `(settled_amount >= 0 AND settled_amount <= amount)` [name: 'sale_expense_payment_bounds']
    `((settled_on IS NOT NULL) = (settled_amount = amount))` [name: 'sale_expense_fully_paid_timestamp']
  }
  Note: 'E45; linked E15 | FIN-002, FIN-004, FIN-009. One Sale owns the expense. Deduct once from Sale net profit; no allocation to models/units. Customer-paid shipping is excluded.'
}

Table sale_expense_payments [headercolor: #A46D46] {
  id integer [pk, not null]
  organization_id integer [not null]
  sale_expense_id integer [not null]
  amount integer [not null, note: 'Actual outgoing installment in integer centavos, counted once as cash. Not another expense or cost allocation.']
  paid_on timestamptz [not null, note: 'Actual cash occurrence, independent of expense incurrence, final completion and recording time.']
  method text [not null]
  created_event_id integer [not null]

  indexes { organization_id }
  checks { `amount > 0` [name: 'positive_sale_expense_payment'] }
  Note: 'E15 sale side | One expense may have many dated payments. T01 must atomically record payment/audit, reconcile settled_amount to authoritative payments, reject overpayment/cross-Organization references and serialize competing payments. Preserve every installment; never replace an earlier payment with a later cumulative value.'
}

// Customers, Sales, immutable physical identities, and Returns.

Table customers [headercolor: #6A61A0] {
  id integer [pk, not null]
  organization_id integer [not null]
  name text [note: 'Supported by CUS-002; mandatory name/phone rules are not specified as they are for Suppliers.']
  phone text
  address_line_1 text
  address_line_2 text
  address_neighborhood text
  address_city text
  address_region text
  address_postal_code text
  address_country text [note: 'Proposed embedded address fields; no fixed country/locale policy is selected.']
  notes text
  created_event_id integer [not null]

  indexes { organization_id }
  Note: 'E16 | CUS-001-015; SAL-004. Address stays on Customer. All fields are private to the Organization. Debt and pending refunds are derived separately; no editable balance or customer wallet.'
}

Table sales [headercolor: #6A61A0] {
  id integer [pk, not null]
  organization_id integer [not null]
  customer_id integer [not null]
  sold_on timestamptz [not null, note: 'Original Sale recognition date; payment timing does not change it.']
  dispatched_on timestamptz
  dispatch_event_id integer
  tracking_code text [note: 'Optional and deliberately NONUNIQUE. Whole-Sale dispatch; no carrier/package fields.']
  canceled_event_id integer [note: 'Ordinary cancellation is allowed only before dispatch.']
  created_event_id integer [not null]

  indexes { organization_id }
  checks {
    `((dispatched_on IS NULL) = (dispatch_event_id IS NULL))` [name: 'dispatch_has_date_and_event']
    `(canceled_event_id IS NULL OR dispatch_event_id IS NULL)` [name: 'ordinary_cancellation_before_dispatch']
  }

  Note: '''
    E18 | SAL-001-028, SAL-036-050. Exactly one Customer. Reserved and In Garage
    derive from debt and dispatch; returned state derives from original shipped lines
    and ReturnItems. No separate readiness stage or automatic reservation expiry.
    Item/price edits preserve original dated facts. Removing all lines cancels the
    Sale without erasing it. Ordinary editing locks after explicit whole-Sale dispatch.
  '''
}

Table sale_items [headercolor: #6A61A0] {
  id integer [pk, not null]
  organization_id integer [not null]
  sale_id integer [not null]
  inventory_item_id integer [not null]
  agreed_price integer [not null, note: 'Current agreed merchandise amount; creation and later changes retain original amounts in dated source history.']
  recognized_acquisition_cost integer [not null, note: 'Specific finalized unit cost used at recognition; never recomputed from later Purchase prices.']
  released_event_id integer [note: 'Null means the commitment remains active, including after dispatch until a valid Return/release. History explains cancellation, removal or physical Return.']
  created_event_id integer [not null]

  indexes { organization_id }

  Note: 'E19 | SAL-001-008, SAL-019, SAL-038-043; INV-007; RET-004, RET-013; CALC-015. One physical unit per line. Many historical SaleItems per Item, at most one active commitment. No product_id, quantity-based substitution, or hard deletion for exchanges.'
}

Table returns [headercolor: #6A61A0] {
  id integer [pk, not null]
  organization_id integer [not null]
  sale_id integer [not null]
  received_on timestamptz [not null]
  reason text
  created_event_id integer [not null, note: 'Event records the authorizing administrator and all atomic physical/financial consequences.']

  indexes { organization_id }
  Note: 'E25 | RET-001-003, RET-006-012. Physical receipt from exactly one originally shipped Sale. Partial Returns select specific original lines. An unshipped cancellation never creates a Return.'
}

Table return_items [headercolor: #6A61A0] {
  id integer [pk, not null]
  organization_id integer [not null]
  return_id integer [not null]
  sale_id integer [not null, note: 'Scope key matching both Return and original SaleItem.']
  sale_item_id integer [not null]
  sealed boolean [note: 'True: sealed; false: open; null: unknown or not applicable. Import mappings must not turn missing evidence into false.']
  damaged boolean [note: 'True: damaged; false: undamaged; null: unknown or not applicable. Damage alone does not select sale eligibility.']
  damage_description text
  approved_for_sale boolean [not null, note: 'Explicit Return-time decision. Damage alone never selects this value.']
  condition_notes text

  indexes { organization_id }
  Note: 'E26 | RET-004-005, RET-008-009, RET-012-013; INV-028. Reaches persistent Item/Product through the original SaleItem. Returned quantity is derived from lines. Condition/eligibility are preserved Return facts and update current inventory atomically.'
}

// Actual customer cash, Sale/line allocations, and legitimately earned retention.

Table customer_payments [headercolor: #497A91] {
  id integer [pk, not null]
  organization_id integer [not null]
  customer_id integer [not null]
  amount integer [not null, note: 'Merchandise portion only; customer-paid shipping is entirely outside application records.']
  paid_on timestamptz [not null]
  method text [not null]
  created_event_id integer [not null]

  indexes { organization_id }
  Note: 'E20 | PAY-001-012, PAY-019, PAY-030; FIN-003. Actual incoming cash, fully allocated at entry to existing Sales/SaleItems of this Customer. No reusable unallocated balance.'
}

Table customer_payment_allocations [headercolor: #497A91] {
  id integer [pk, not null]
  organization_id integer [not null]
  customer_id integer [not null, note: 'Scope key matching both original Payment and target Sale.']
  customer_payment_id integer [not null]
  sale_id integer [not null]
  sale_item_id integer [not null, note: 'Exactly one SaleItem, constrained to this same Sale/Customer. Sale-level-only funding is not permitted.']
  amount integer [not null, note: 'Preserved allocation amount; effective funding includes dated releases/reclassifications.']
  created_event_id integer [not null]

  indexes { organization_id }
  Note: 'E21 | PAY-002-020, PAY-030, PAY-037. Source Payment identity survives reassignment. Allocation limits apply to source, Sale and identified line, including concurrency. Refunds consume oldest original Payments first. Equal-time/non-refund source order remains design work.'
}

Table customer_refunds [headercolor: #497A91] {
  id integer [pk, not null]
  organization_id integer [not null]
  customer_id integer [not null]
  sale_id integer [not null]
  settlement_id integer [not null, note: 'Approved customer-side settlement; original funding portions are traced through its source allocations.']
  amount integer [not null]
  refunded_on timestamptz [not null]
  method text [not null]
  created_event_id integer [not null]

  indexes { organization_id }
  Note: 'E24 | PAY-021-029, PAY-033, PAY-036, PAY-038; CUS-011-012. Actual outgoing cash only. Pending refund amounts live in source-linked settlement obligations. Refund cash never reverses the same Sale profit again.'
}

Table retained_income [headercolor: #497A91] {
  id integer [pk, not null]
  organization_id integer [not null]
  sale_id integer [not null]
  settlement_id integer [not null, note: 'Approved customer-side settlement; original funding portions are traced through its source allocations.']
  amount integer [not null]
  recognized_on timestamptz [not null]
  reason text [not null, note: 'Explain why an amount actually received is legitimately earned and retained.']
  created_event_id integer [not null]

  indexes { organization_id }
  Note: 'E27 | PAY-024, PAY-033-035; RET-011. Separate earned income after applicable edit/cancellation/Return; not a new cash receipt or automatic substitute for a refund. Original Sale economics are reversed independently.'
}

Table retained_income_allocations [headercolor: #497A91] {
  id integer [pk, not null]
  organization_id integer [not null]
  retained_income_id integer [not null]
  sale_id integer [not null, note: 'Scope key matching retained income and the affected SaleItem.']
  sale_item_id integer [not null]
  amount integer [not null]
  created_event_id integer [not null]

  indexes { organization_id }
  Note: 'E28 | PAY-034; COL-020; CALC-015-016. Exact model attribution through SaleItem -> InventoryItem -> Product. Reconcile to the retained total. Header plus allocations is a proposed physical boundary; income lines could represent the same facts.'
}

// Loss and shared domain history. No independent editable financial ledger.

Table losses [headercolor: #96616D] {
  id integer [pk, not null]
  organization_id integer [not null]
  inventory_item_id integer
  purchase_id integer
  sale_id integer
  amount integer [not null]
  occurred_on timestamptz [not null]
  reason text [not null]
  reversed_event_id integer [note: 'Dated full void/reversal provenance. Partial economic adjustments retain source-component links in shared history. D06 governs authority and stock consequences.']
  created_event_id integer [not null]

  indexes { organization_id }
  Note: 'E29 | LOS-001-008; PUR-031-033. Context references may coexist but must describe the same loss. Lost funding retains typed original-allocation provenance through supplier settlement sources. One economic write-off with its stock effect. Actual later refunds use SupplierRefund, never LossRecovery.'
}

Table business_events [headercolor: #96616D] {
  id integer [pk, not null]
  scope business_event_scope [not null]
  organization_id integer [note: 'Required for private operational actions; null for global Product actions.']
  context_organization_id integer [note: 'Optional global-action provenance; never Product ownership or access to this Organization\'s private records.']
  actor_user_id integer [not null]
  action_type text [not null, note: 'Proposed typed action discriminator. Action/payload contracts need review; existing Product maintenance remains D07.']
  occurred_at timestamptz [not null, note: 'Actual action occurrence instant, distinct from source occurrence and recorded_at. Convert timezone-aware input to UTC; no independent financial adjustment transaction.']
  recorded_at timestamptz [not null]
  reason text
  reverses_event_id integer [note: 'Original action when applicable; component-level provenance is also preserved below.']

  checks {
    `((scope = 'organization' AND organization_id IS NOT NULL) OR (scope = 'global_product' AND organization_id IS NULL))` [name: 'business_event_scope_matches_owner']
  }

  Note: '''
    E32 and E35 | REQ-002-003, REQ-006-007, REQ-010-012; INV-026; FIN-011.
    One shared action/audit history with actor, occurrence and recording timestamps,
    reasons, changed business facts and reversal provenance. Global Product audit
    governance remains D07; global registration is already approved.
    A transaction must atomically commit sources, changes and consequences.
    This header alone neither enforces atomicity nor prescribes event sourcing.
  '''
}

Table business_event_changes [headercolor: #96616D] {
  id integer [pk, not null]
  business_event_id integer [not null]
  organization_id integer [note: 'Must match event and all operational subjects; null only for a global Product subject.']
  sequence integer [not null]
  change_kind text [not null, note: 'Validated domain fact kind, including source creation, allocation change, cost lock, membership change and dated economic adjustment.']
  product_id integer
  membership_user_id integer [note: 'User affected by an Organization Membership grant/change/revocation. before_facts/after_facts retain the role and grant facts; no FK to the deleted Membership row.']
  inventory_item_id integer
  supplier_id integer
  purchase_id integer
  purchase_item_id integer
  supplier_payment_id integer
  supplier_payment_allocation_id integer
  supplier_refund_id integer
  purchase_expense_id integer
  purchase_expense_payment_id integer
  acquisition_expense_allocation_id integer
  customer_id integer
  sale_id integer
  sale_item_id integer
  sale_expense_id integer
  sale_expense_payment_id integer
  customer_payment_id integer
  customer_payment_allocation_id integer
  customer_refund_id integer
  return_id integer
  return_item_id integer
  retained_income_id integer
  retained_income_allocation_id integer
  loss_id integer
  customer_settlement_id integer
  customer_settlement_source_allocation_id integer
  supplier_settlement_id integer
  supplier_settlement_source_allocation_id integer
  before_facts jsonb [note: 'Proposed typed, versioned business snapshot, not arbitrary log text. Preserve original amounts, dates, allocations, state and collection membership as applicable.']
  after_facts jsonb [note: 'Validated against change_kind and the referenced source. Historical projections must query these preserved facts reliably.']
  reverses_change_id integer [note: 'Original source component for a full/partial adjustment. Amounts and affected facts are explicit in the typed snapshots; D06 policy remains open.']

  checks {
    `num_nonnulls(product_id, membership_user_id, inventory_item_id, supplier_id, purchase_id, purchase_item_id, supplier_payment_id, supplier_payment_allocation_id, supplier_refund_id, purchase_expense_id, purchase_expense_payment_id, acquisition_expense_allocation_id, customer_id, sale_id, sale_item_id, sale_expense_id, sale_expense_payment_id, customer_payment_id, customer_payment_allocation_id, customer_refund_id, return_id, return_item_id, retained_income_id, retained_income_allocation_id, loss_id, customer_settlement_id, customer_settlement_source_allocation_id, supplier_settlement_id, supplier_settlement_source_allocation_id) = 1` [name: 'one_typed_business_subject']
    `((organization_id IS NULL AND product_id IS NOT NULL) OR (organization_id IS NOT NULL AND product_id IS NULL))` [name: 'change_subject_matches_scope']
    `(before_facts IS NOT NULL OR after_facts IS NOT NULL)` [name: 'preserved_business_facts']
    `sequence > 0` [name: 'positive_change_sequence']
  }

  Note: '''
    Proposed typed detail storage for E32/E35, not a new standalone audit domain.
    Exactly one FK-backed subject per change; an action may change many sources.
    Related Item links derive through typed subjects; create explicit Item changes
    for receipt, condition, approval, hold, membership, commitment and disposition.
    E33 timeline and E34 financial reports derive from original source facts plus
    these dated changes. Never count both a source and its creation snapshot twice.
    JSON payload shapes, versioning and reporting queries remain T01/T06 design work;
    unvalidated generic audit JSON would not satisfy the historical requirements.
  '''
}

// Approved customer/supplier settlement storage (Q61). The rejected mixed candidates
// and persistent import-row candidates are absent.

Table customer_settlements [headercolor: #497A91] {
  id integer [pk, not null]
  organization_id integer [not null]
  customer_id integer [not null]
  sale_id integer [not null]
  return_id integer [note: 'Optional Return from this same Sale; a pre-dispatch correction/cancellation has no Return.']
  created_event_id integer [not null]

  indexes { organization_id }
  Note: 'E36 customer side | Approved dedicated settlement header. Resolves released funding for this Customer/Sale. Completeness derives from source portions and outcomes; pending refunds are obligations, never cash or a reusable wallet.'
}

Table customer_settlement_source_allocations [headercolor: #497A91] {
  id integer [pk, not null]
  organization_id integer [not null]
  settlement_id integer [not null]
  source_customer_payment_allocation_id integer [not null]
  amount integer [not null, note: 'Positive portion of original funding; resolve it exactly once. Refund portions consume oldest original Payments first.']
  outcome customer_settlement_outcome [not null]
  customer_refund_id integer [note: 'Null while a refund is pending; populated for its one actual cash disbursement.']
  target_customer_payment_allocation_id integer [note: 'Eligible existing SaleItem of the same Customer/Organization; must retain the same original Payment.']
  retained_income_id integer
  created_event_id integer [not null]

  indexes { organization_id }
  checks {
    `amount > 0` [name: 'positive_customer_settlement_portion']
    `((outcome = 'refund' AND target_customer_payment_allocation_id IS NULL AND retained_income_id IS NULL) OR (outcome = 'reassignment' AND target_customer_payment_allocation_id IS NOT NULL AND customer_refund_id IS NULL AND retained_income_id IS NULL) OR (outcome = 'retained_income' AND retained_income_id IS NOT NULL AND customer_refund_id IS NULL AND target_customer_payment_allocation_id IS NULL))` [name: 'one_customer_settlement_outcome']
  }
  Note: 'E37 customer side | Several original funding portions may explain one actual Refund or RetainedIncome. Preserve dated paid/pending history. T01 must enforce matching Customer/Organization, original Payment, settlement/Sale context, limits and exact reconciliation under concurrency. Reassignment creates no cash.'
}

Table supplier_settlements [headercolor: #97703C] {
  id integer [pk, not null]
  organization_id integer [not null]
  supplier_id integer [not null]
  purchase_id integer [note: 'Optional context. Source portions may span several Purchases of this same Supplier.']
  created_event_id integer [not null]

  indexes { organization_id }
  Note: 'E36 supplier side | Approved dedicated settlement header. Resolves funding of this Supplier\'s units, preserving original Purchases through allocations. A pending refund is an obligation, not cash received or reusable supplier credit.'
}

Table supplier_settlement_source_allocations [headercolor: #97703C] {
  id integer [pk, not null]
  organization_id integer [not null]
  settlement_id integer [not null]
  source_supplier_payment_allocation_id integer [not null]
  amount integer [not null, note: 'Positive portion of original funding; resolve it exactly once.']
  outcome supplier_settlement_outcome [not null]
  supplier_refund_id integer [note: 'Null while a refund is pending; populated only for one actual cash receipt.']
  target_supplier_payment_allocation_id integer [note: 'Explicit valid allocation correction only, retaining original Payment/Supplier; no supplier credit.']
  loss_id integer
  related_prior_loss_id integer [note: 'Original write-off context for money actually received later; do not count the same funding recovery twice.']
  created_event_id integer [not null]

  indexes { organization_id }
  checks {
    `amount > 0` [name: 'positive_supplier_settlement_portion']
    `((outcome = 'refund' AND target_supplier_payment_allocation_id IS NULL AND loss_id IS NULL) OR (outcome = 'reassignment' AND target_supplier_payment_allocation_id IS NOT NULL AND supplier_refund_id IS NULL AND loss_id IS NULL) OR (outcome = 'loss' AND loss_id IS NOT NULL AND supplier_refund_id IS NULL AND target_supplier_payment_allocation_id IS NULL))` [name: 'one_supplier_settlement_outcome']
  }
  Note: 'E37 supplier side | Preserve original Payment/allocation and Purchase/unit provenance. T01 must enforce Supplier/Organization/context matching, limits and exact reconciliation under concurrency. Refund FIFO is approved; equal-time/non-refund ordering and exceptional D06 disposition remain open.'
}



