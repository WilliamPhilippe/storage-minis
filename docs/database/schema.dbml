Ref owner_customer_settlements: customer_settlements.organization_id > organizations.id [delete: restrict]
Ref owner_customer_settlement_sources: customer_settlement_source_allocations.organization_id > organizations.id [delete: restrict]
Ref owner_supplier_settlements: supplier_settlements.organization_id > organizations.id [delete: restrict]
Ref owner_supplier_settlement_sources: supplier_settlement_source_allocations.organization_id > organizations.id [delete: restrict]
Ref customer_settlement_customer: customer_settlements.(organization_id, customer_id) > customers.(organization_id, id) [delete: restrict]
Ref customer_settlement_sale: customer_settlements.(organization_id, customer_id, sale_id) > sales.(organization_id, customer_id, id) [delete: restrict]
Ref customer_settlement_return: customer_settlements.(organization_id, sale_id, return_id) > returns.(organization_id, sale_id, id) [delete: restrict]
Ref customer_settlement_source_header: customer_settlement_source_allocations.(organization_id, settlement_id) > customer_settlements.(organization_id, id) [delete: restrict]
Ref customer_settlement_source_payment: customer_settlement_source_allocations.(organization_id, source_customer_payment_allocation_id) > customer_payment_allocations.(organization_id, id) [delete: restrict]
Ref customer_settlement_source_refund: customer_settlement_source_allocations.(organization_id, customer_refund_id) > customer_refunds.(organization_id, id) [delete: restrict]
Ref customer_settlement_source_target: customer_settlement_source_allocations.(organization_id, target_customer_payment_allocation_id) > customer_payment_allocations.(organization_id, id) [delete: restrict]
Ref customer_settlement_source_retention: customer_settlement_source_allocations.(organization_id, retained_income_id) > retained_income.(organization_id, id) [delete: restrict]
Ref supplier_settlement_supplier: supplier_settlements.(organization_id, supplier_id) > suppliers.(organization_id, id) [delete: restrict]
Ref supplier_settlement_purchase: supplier_settlements.(organization_id, supplier_id, purchase_id) > purchases.(organization_id, supplier_id, id) [delete: restrict]
Ref supplier_settlement_source_header: supplier_settlement_source_allocations.(organization_id, settlement_id) > supplier_settlements.(organization_id, id) [delete: restrict]
Ref supplier_settlement_source_payment: supplier_settlement_source_allocations.(organization_id, source_supplier_payment_allocation_id) > supplier_payment_allocations.(organization_id, id) [delete: restrict]
Ref supplier_settlement_source_refund: supplier_settlement_source_allocations.(organization_id, supplier_refund_id) > supplier_refunds.(organization_id, id) [delete: restrict]
Ref supplier_settlement_source_target: supplier_settlement_source_allocations.(organization_id, target_supplier_payment_allocation_id) > supplier_payment_allocations.(organization_id, id) [delete: restrict]
Ref supplier_settlement_source_loss: supplier_settlement_source_allocations.(organization_id, loss_id) > losses.(organization_id, id) [delete: restrict]
Ref supplier_settlement_source_prior_loss: supplier_settlement_source_allocations.(organization_id, related_prior_loss_id) > losses.(organization_id, id) [delete: restrict]
Ref supplier_refund_settlement_party: supplier_refunds.(organization_id, supplier_id, settlement_id) > supplier_settlements.(organization_id, supplier_id, id) [delete: restrict]
Ref customer_refund_settlement_sale_party: customer_refunds.(organization_id, customer_id, sale_id, settlement_id) > customer_settlements.(organization_id, customer_id, sale_id, id) [delete: restrict]
Ref retained_income_settlement_sale: retained_income.(organization_id, sale_id, settlement_id) > customer_settlements.(organization_id, sale_id, id) [delete: restrict]
Ref created_customer_settlements: customer_settlements.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_customer_settlement_source_allocations: customer_settlement_source_allocations.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_supplier_settlements: supplier_settlements.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_supplier_settlement_source_allocations: supplier_settlement_source_allocations.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref change_customer_settlement_id: business_event_changes.(organization_id, customer_settlement_id) > customer_settlements.(organization_id, id) [delete: restrict]
Ref change_customer_settlement_source_allocation_id: business_event_changes.(organization_id, customer_settlement_source_allocation_id) > customer_settlement_source_allocations.(organization_id, id) [delete: restrict]
Ref change_supplier_settlement_id: business_event_changes.(organization_id, supplier_settlement_id) > supplier_settlements.(organization_id, id) [delete: restrict]
Ref change_supplier_settlement_source_allocation_id: business_event_changes.(organization_id, supplier_settlement_source_allocation_id) > supplier_settlement_source_allocations.(organization_id, id) [delete: restrict]

Ref owner_purchase_expense_payments: purchase_expense_payments.organization_id > organizations.id [delete: restrict]
Ref purchase_expense_payment_source: purchase_expense_payments.(organization_id, purchase_expense_id) > purchase_expenses.(organization_id, id) [delete: restrict]
Ref created_purchase_expense_payments: purchase_expense_payments.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref change_purchase_expense_payment: business_event_changes.(organization_id, purchase_expense_payment_id) > purchase_expense_payments.(organization_id, id) [delete: restrict]
Ref owner_sale_expense_payments: sale_expense_payments.organization_id > organizations.id [delete: restrict]
Ref sale_expense_payment_source: sale_expense_payments.(organization_id, sale_expense_id) > sale_expenses.(organization_id, id) [delete: restrict]
Ref created_sale_expense_payments: sale_expense_payments.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref change_sale_expense_payment: business_event_changes.(organization_id, sale_expense_payment_id) > sale_expense_payments.(organization_id, id) [delete: restrict]

// Visual groups and notes; these are not PostgreSQL schema/module decisions.

