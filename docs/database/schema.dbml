Ref owner_supplier_refunds: supplier_refunds.organization_id > organizations.id [delete: restrict]
Ref owner_purchase_expenses: purchase_expenses.organization_id > organizations.id [delete: restrict]
Ref owner_purchase_expense_purchases: purchase_expense_purchases.organization_id > organizations.id [delete: restrict]
Ref owner_acquisition_expense_allocations: acquisition_expense_allocations.organization_id > organizations.id [delete: restrict]
Ref owner_sale_expenses: sale_expenses.organization_id > organizations.id [delete: restrict]
Ref owner_customers: customers.organization_id > organizations.id [delete: restrict]
Ref owner_sales: sales.organization_id > organizations.id [delete: restrict]
Ref owner_sale_items: sale_items.organization_id > organizations.id [delete: restrict]
Ref owner_returns: returns.organization_id > organizations.id [delete: restrict]
Ref owner_return_items: return_items.organization_id > organizations.id [delete: restrict]
Ref owner_customer_payments: customer_payments.organization_id > organizations.id [delete: restrict]
Ref owner_customer_payment_allocations: customer_payment_allocations.organization_id > organizations.id [delete: restrict]
Ref owner_customer_refunds: customer_refunds.organization_id > organizations.id [delete: restrict]
Ref owner_retained_income: retained_income.organization_id > organizations.id [delete: restrict]
Ref owner_retained_income_allocations: retained_income_allocations.organization_id > organizations.id [delete: restrict]
Ref owner_losses: losses.organization_id > organizations.id [delete: restrict]
Ref owner_business_events: business_events.organization_id > organizations.id [delete: restrict]
Ref owner_business_event_changes: business_event_changes.organization_id > organizations.id [delete: restrict]
Ref owner_financial_settlements: candidate.financial_settlements.organization_id > organizations.id [delete: restrict]
Ref owner_settlement_source_allocations: candidate.settlement_source_allocations.organization_id > organizations.id [delete: restrict]
Ref owner_opening_acquisitions: candidate.opening_acquisitions.organization_id > organizations.id [delete: restrict]
Ref owner_import_batches: candidate.import_batches.organization_id > organizations.id [delete: restrict]
Ref owner_import_rows: candidate.import_rows.organization_id > organizations.id [delete: restrict]
Ref owner_import_row_inventory_items: candidate.import_row_inventory_items.organization_id > organizations.id [delete: restrict]
Ref membership_user: memberships.user_id > users.id [delete: restrict]
Ref unit_global_product: inventory_items.product_id > products.id [delete: restrict]
Ref product_registration: products.registration_event_id > business_events.id [delete: restrict]
Ref unit_purchase: inventory_items.(organization_id, purchase_id) > purchases.(organization_id, id) [delete: restrict]
Ref unit_purchase_line: inventory_items.(organization_id, purchase_id, purchase_item_id) > purchase_items.(organization_id, purchase_id, id) [delete: restrict]
Ref unit_opening_candidate: inventory_items.(organization_id, opening_acquisition_id) > candidate.opening_acquisitions.(organization_id, id) [delete: restrict]
Ref purchase_supplier: purchases.(organization_id, supplier_id) > suppliers.(organization_id, id) [delete: restrict]
Ref purchase_line_header: purchase_items.(organization_id, purchase_id) > purchases.(organization_id, id) [delete: restrict]
Ref supplier_payment_party: supplier_payments.(organization_id, supplier_id) > suppliers.(organization_id, id) [delete: restrict]
Ref supplier_allocation_payment_party: supplier_payment_allocations.(organization_id, supplier_id, supplier_payment_id) > supplier_payments.(organization_id, supplier_id, id) [delete: restrict]
Ref supplier_allocation_purchase_party: supplier_payment_allocations.(organization_id, supplier_id, purchase_id) > purchases.(organization_id, supplier_id, id) [delete: restrict]
Ref supplier_allocation_unit_purchase: supplier_payment_allocations.(organization_id, purchase_id, inventory_item_id) > inventory_items.(organization_id, purchase_id, id) [delete: restrict]
Ref supplier_refund_party: supplier_refunds.(organization_id, supplier_id) > suppliers.(organization_id, id) [delete: restrict]
Ref supplier_refund_settlement_party: supplier_refunds.(organization_id, supplier_id, settlement_id) > candidate.financial_settlements.(organization_id, supplier_id, id) [delete: restrict]
Ref supplier_refund_original_loss: supplier_refunds.(organization_id, related_loss_id) > losses.(organization_id, id) [delete: restrict]
Ref expense_link_source: purchase_expense_purchases.(organization_id, purchase_expense_id) > purchase_expenses.(organization_id, id) [delete: restrict]
Ref expense_link_purchase: purchase_expense_purchases.(organization_id, purchase_id) > purchases.(organization_id, id) [delete: restrict]
Ref expense_allocation_linked_purchase: acquisition_expense_allocations.(organization_id, purchase_expense_id, purchase_id) > purchase_expense_purchases.(organization_id, purchase_expense_id, purchase_id) [delete: restrict]
Ref expense_allocation_unit_purchase: acquisition_expense_allocations.(organization_id, purchase_id, inventory_item_id) > inventory_items.(organization_id, purchase_id, id) [delete: restrict]
Ref selling_expense_sale: sale_expenses.(organization_id, sale_id) > sales.(organization_id, id) [delete: restrict]
Ref sale_customer: sales.(organization_id, customer_id) > customers.(organization_id, id) [delete: restrict]
Ref sale_line_header: sale_items.(organization_id, sale_id) > sales.(organization_id, id) [delete: restrict]
Ref sale_line_unit: sale_items.(organization_id, inventory_item_id) > inventory_items.(organization_id, id) [delete: restrict]
Ref return_original_sale: returns.(organization_id, sale_id) > sales.(organization_id, id) [delete: restrict]
Ref return_line_header_sale: return_items.(organization_id, sale_id, return_id) > returns.(organization_id, sale_id, id) [delete: restrict]
Ref return_line_original_sale_line: sale_items.(organization_id, sale_id, id) - return_items.(organization_id, sale_id, sale_item_id) [delete: restrict]
Ref customer_payment_party: customer_payments.(organization_id, customer_id) > customers.(organization_id, id) [delete: restrict]
Ref customer_allocation_payment_party: customer_payment_allocations.(organization_id, customer_id, customer_payment_id) > customer_payments.(organization_id, customer_id, id) [delete: restrict]
Ref customer_allocation_sale_party: customer_payment_allocations.(organization_id, customer_id, sale_id) > sales.(organization_id, customer_id, id) [delete: restrict]
Ref customer_allocation_optional_sale_line: customer_payment_allocations.(organization_id, sale_id, sale_item_id) > sale_items.(organization_id, sale_id, id) [delete: restrict]
Ref customer_refund_sale_party: customer_refunds.(organization_id, customer_id, sale_id) > sales.(organization_id, customer_id, id) [delete: restrict]
Ref customer_refund_settlement_sale_party: customer_refunds.(organization_id, customer_id, sale_id, settlement_id) > candidate.financial_settlements.(organization_id, customer_id, sale_id, id) [delete: restrict]
Ref retained_income_sale: retained_income.(organization_id, sale_id) > sales.(organization_id, id) [delete: restrict]
Ref retained_income_settlement_sale: retained_income.(organization_id, sale_id, settlement_id) > candidate.financial_settlements.(organization_id, sale_id, id) [delete: restrict]
Ref retained_allocation_income_sale: retained_income_allocations.(organization_id, sale_id, retained_income_id) > retained_income.(organization_id, sale_id, id) [delete: restrict]
Ref retained_allocation_affected_sale_line: retained_income_allocations.(organization_id, sale_id, sale_item_id) > sale_items.(organization_id, sale_id, id) [delete: restrict]
Ref loss_inventory_item: losses.(organization_id, inventory_item_id) > inventory_items.(organization_id, id) [delete: restrict]
Ref loss_purchase: losses.(organization_id, purchase_id) > purchases.(organization_id, id) [delete: restrict]
Ref loss_sale: losses.(organization_id, sale_id) > sales.(organization_id, id) [delete: restrict]
Ref event_actor: business_events.actor_user_id > users.id [delete: restrict]
Ref event_context: business_events.context_organization_id > organizations.id [delete: restrict]
Ref event_reversal_identity: business_events.reverses_event_id > business_events.id [delete: restrict]
Ref event_reversal_owner: business_events.(organization_id, reverses_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref change_event_identity: business_event_changes.business_event_id > business_events.id [delete: restrict]
Ref change_event_owner: business_event_changes.(organization_id, business_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref change_global_product: business_event_changes.product_id > products.id [delete: restrict]
Ref change_reversal_identity: business_event_changes.reverses_change_id > business_event_changes.id [delete: restrict]
Ref change_reversal_owner: business_event_changes.(organization_id, reverses_change_id) > business_event_changes.(organization_id, id) [delete: restrict]
Ref change_inventory_item: business_event_changes.(organization_id, inventory_item_id) > inventory_items.(organization_id, id) [delete: restrict]
Ref change_supplier: business_event_changes.(organization_id, supplier_id) > suppliers.(organization_id, id) [delete: restrict]
Ref change_purchase: business_event_changes.(organization_id, purchase_id) > purchases.(organization_id, id) [delete: restrict]
Ref change_purchase_item: business_event_changes.(organization_id, purchase_item_id) > purchase_items.(organization_id, id) [delete: restrict]
Ref change_supplier_payment: business_event_changes.(organization_id, supplier_payment_id) > supplier_payments.(organization_id, id) [delete: restrict]
Ref change_supplier_payment_allocation: business_event_changes.(organization_id, supplier_payment_allocation_id) > supplier_payment_allocations.(organization_id, id) [delete: restrict]
Ref change_supplier_refund: business_event_changes.(organization_id, supplier_refund_id) > supplier_refunds.(organization_id, id) [delete: restrict]
