Ref change_customer: business_event_changes.(organization_id, customer_id) > customers.(organization_id, id) [delete: restrict]
Ref change_sale: business_event_changes.(organization_id, sale_id) > sales.(organization_id, id) [delete: restrict]
Ref change_sale_item: business_event_changes.(organization_id, sale_item_id) > sale_items.(organization_id, id) [delete: restrict]
Ref change_sale_expense: business_event_changes.(organization_id, sale_expense_id) > sale_expenses.(organization_id, id) [delete: restrict]
Ref change_customer_payment: business_event_changes.(organization_id, customer_payment_id) > customer_payments.(organization_id, id) [delete: restrict]
Ref change_customer_payment_allocation: business_event_changes.(organization_id, customer_payment_allocation_id) > customer_payment_allocations.(organization_id, id) [delete: restrict]
Ref change_customer_refund: business_event_changes.(organization_id, customer_refund_id) > customer_refunds.(organization_id, id) [delete: restrict]
Ref change_return: business_event_changes.(organization_id, return_id) > returns.(organization_id, id) [delete: restrict]
Ref change_return_item: business_event_changes.(organization_id, return_item_id) > return_items.(organization_id, id) [delete: restrict]
Ref change_retained_income: business_event_changes.(organization_id, retained_income_id) > retained_income.(organization_id, id) [delete: restrict]
Ref change_retained_income_allocation: business_event_changes.(organization_id, retained_income_allocation_id) > retained_income_allocations.(organization_id, id) [delete: restrict]
Ref change_loss: business_event_changes.(organization_id, loss_id) > losses.(organization_id, id) [delete: restrict]
Ref change_financial_settlement: business_event_changes.(organization_id, financial_settlement_id) > candidate.financial_settlements.(organization_id, id) [delete: restrict]
Ref change_settlement_source_allocation: business_event_changes.(organization_id, settlement_source_allocation_id) > candidate.settlement_source_allocations.(organization_id, id) [delete: restrict]
Ref settlement_customer: candidate.financial_settlements.(organization_id, customer_id) > customers.(organization_id, id) [delete: restrict]
Ref settlement_supplier: candidate.financial_settlements.(organization_id, supplier_id) > suppliers.(organization_id, id) [delete: restrict]
Ref settlement_sale_customer: candidate.financial_settlements.(organization_id, customer_id, sale_id) > sales.(organization_id, customer_id, id) [delete: restrict]
Ref settlement_purchase_supplier: candidate.financial_settlements.(organization_id, supplier_id, purchase_id) > purchases.(organization_id, supplier_id, id) [delete: restrict]
Ref settlement_return_sale: candidate.financial_settlements.(organization_id, sale_id, return_id) > returns.(organization_id, sale_id, id) [delete: restrict]
Ref resolution_settlement: candidate.settlement_source_allocations.(organization_id, settlement_id) > candidate.financial_settlements.(organization_id, id) [delete: restrict]
Ref resolution_source_customer_payment_allocation: candidate.settlement_source_allocations.(organization_id, source_customer_payment_allocation_id) > customer_payment_allocations.(organization_id, id) [delete: restrict]
Ref resolution_source_supplier_payment_allocation: candidate.settlement_source_allocations.(organization_id, source_supplier_payment_allocation_id) > supplier_payment_allocations.(organization_id, id) [delete: restrict]
Ref resolution_customer_refund: candidate.settlement_source_allocations.(organization_id, customer_refund_id) > customer_refunds.(organization_id, id) [delete: restrict]
Ref resolution_supplier_refund: candidate.settlement_source_allocations.(organization_id, supplier_refund_id) > supplier_refunds.(organization_id, id) [delete: restrict]
Ref resolution_target_customer_payment_allocation: candidate.settlement_source_allocations.(organization_id, target_customer_payment_allocation_id) > customer_payment_allocations.(organization_id, id) [delete: restrict]
Ref resolution_target_supplier_payment_allocation: candidate.settlement_source_allocations.(organization_id, target_supplier_payment_allocation_id) > supplier_payment_allocations.(organization_id, id) [delete: restrict]
Ref resolution_retained_income: candidate.settlement_source_allocations.(organization_id, retained_income_id) > retained_income.(organization_id, id) [delete: restrict]
Ref resolution_loss: candidate.settlement_source_allocations.(organization_id, loss_id) > losses.(organization_id, id) [delete: restrict]
Ref resolution_related_prior_loss: candidate.settlement_source_allocations.(organization_id, related_prior_loss_id) > losses.(organization_id, id) [delete: restrict]
Ref import_actor: candidate.import_batches.actor_user_id > users.id [delete: restrict]
Ref import_row_batch: candidate.import_rows.(organization_id, import_batch_id) > candidate.import_batches.(organization_id, id) [delete: restrict]
Ref import_result_row: candidate.import_row_inventory_items.(organization_id, import_row_id) > candidate.import_rows.(organization_id, id) [delete: restrict]
Ref import_result_unit: candidate.import_row_inventory_items.(organization_id, inventory_item_id) > inventory_items.(organization_id, id) [delete: restrict]
Ref created_inventory_items: inventory_items.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_suppliers: suppliers.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_purchases: purchases.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_purchase_items: purchase_items.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_supplier_payments: supplier_payments.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_supplier_payment_allocations: supplier_payment_allocations.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_supplier_refunds: supplier_refunds.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_purchase_expenses: purchase_expenses.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_acquisition_expense_allocations: acquisition_expense_allocations.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_sale_expenses: sale_expenses.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_customers: customers.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_sales: sales.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_sale_items: sale_items.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_returns: returns.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_customer_payments: customer_payments.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_customer_payment_allocations: customer_payment_allocations.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_customer_refunds: customer_refunds.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_retained_income: retained_income.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_retained_income_allocations: retained_income_allocations.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_losses: losses.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_financial_settlements: candidate.financial_settlements.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_settlement_source_allocations: candidate.settlement_source_allocations.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref created_opening_acquisitions: candidate.opening_acquisitions.(organization_id, created_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref inventory_items_first_received: inventory_items.(organization_id, first_received_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref inventory_items_first_sale_approval: inventory_items.(organization_id, first_sale_approval_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref inventory_items_removed: inventory_items.(organization_id, removed_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref inventory_items_cost_finalized: inventory_items.(organization_id, cost_finalized_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref purchases_expenses_confirmed: purchases.(organization_id, expenses_confirmed_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref purchases_completed: purchases.(organization_id, completed_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref purchases_canceled: purchases.(organization_id, canceled_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref purchase_expenses_settlement: purchase_expenses.(organization_id, settlement_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref sale_expenses_settlement: sale_expenses.(organization_id, settlement_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref sales_dispatch: sales.(organization_id, dispatch_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref sales_canceled: sales.(organization_id, canceled_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref sale_items_released: sale_items.(organization_id, released_event_id) > business_events.(organization_id, id) [delete: restrict]
Ref losses_reversed: losses.(organization_id, reversed_event_id) > business_events.(organization_id, id) [delete: restrict]

// Visual groups and notes; these are not PostgreSQL schema/module decisions.

TableGroup identity_and_access [color: #4B6B9E] {
  organizations
  users
  memberships
}

TableGroup catalog_and_inventory [color: #387D70] {
  products
  inventory_items
}

TableGroup purchasing_and_supplier_funding [color: #97703C] {
  suppliers
  purchases
  purchase_items
  supplier_payments
  supplier_payment_allocations
  supplier_refunds
}

TableGroup acquisition_and_selling_expenses [color: #A46D46] {
  purchase_expenses
  purchase_expense_purchases
  acquisition_expense_allocations
  sale_expenses
}

TableGroup sales_and_returns [color: #6A61A0] {
  customers
  sales
  sale_items
  returns
  return_items
}

TableGroup customer_funding_and_retention [color: #497A91] {
  customer_payments
  customer_payment_allocations
  customer_refunds
  retained_income
  retained_income_allocations
}

TableGroup losses_and_shared_history [color: #96616D] {
  losses
  business_events
  business_event_changes
}

TableGroup candidate_settlement_storage [color: #A68A4A] {
  candidate.financial_settlements
  candidate.settlement_source_allocations
  Note: 'E36/E37 are optional storage boundaries for required settlement/provenance facts. They may instead be typed shared-history details. Not a wallet or additional product scope.'
}

TableGroup candidate_legacy_import_storage [color: #8D8D8D] {
  candidate.opening_acquisitions
  candidate.import_batches
  candidate.import_rows
  candidate.import_row_inventory_items
  Note: 'E39-E41 are conditional on T05 and actual spreadsheet evidence. These boxes do not approve an import mapping, assumed cost/date, or new ongoing import-management feature.'
}

Note review_status {
  '''
    DRAFT 1 — visual review before the first migration.
    v0.7 requirements remain authoritative. Fields/table boundaries are proposals.
    brl_amount + business_date are unresolved T03 types; SQL export is not runnable.
    Partial indexes and transaction/concurrency enforcement are not fully represented.
    Amber/gray candidate groups are optional storage; details are in design.md.
  '''
}

Note embedded_and_derived_entries {
  '''
    Mapped without separate tables:
    E15 expense payment information -> each expense's embedded settlement fields.
    E33 ItemHistoryEntry -> timeline over Item-linked sources and shared history.
    E34 FinancialEffect -> reporting projection over dated source facts/adjustments.
    E35 AuditEntry -> BusinessEvent plus typed change details.
    E42 Product image values -> products.images (encoding/storage still open).
    E43 Brand value -> products.brand.
    E44 ItemCostSnapshot -> InventoryItem snapshot fields plus preserved allocations;
        a separate versioned record remains conditional on D06.
    No Reservation, Garage, Collection, credit, balance, Profit or LossRecovery table.
    Retired E12, E17, E22, E23, E30, E31 and E38 are not reused.
  '''
}

Note shared_expense_example {
  '''
    P1 has I1/I2; P2 has I3/I4, all in the same Organization.
    One BRL 30 PurchaseExpense links P1 and P2.
    Allocate BRL 10 to I1 and BRL 20 to I4; I2/I3 receive none.
    Purchase subtotals derive as 10/20; source and settlement remain 30 once.
    Completing P1 preserves P2's independent progress and every protected unit cost.
  '''
}

Note policy_boundaries {
  '''
    D01 partial-Return funding-source selection; D02 historical collection presentation;
    D03 negative recovery profit; D04 public catalog fields/context/images;
    D05 report/average-cost basis; D06 exceptional corrections and expense disposition;
    D07 existing shared Product edits/global audit/private annotations/historical labels;
    D08 finalization of never-approved collection-unit costs.
    T02 remaining access/session/bootstrap; T03 exact money/business dates;
    T05 reviewed opening acquisition and spreadsheet mapping.
    No policy is selected merely by drawing a table or relationship here.
  '''
}
