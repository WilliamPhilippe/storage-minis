# Vite's development mode (`pnpm dev`, and the dev server `pnpm test:e2e`
# starts): the Firebase dev project's web config (sign-in plan SI-03). These
# are public identifiers that every visitor's browser receives (W10), never
# secrets and never Doppler. vite.config.mts checks them when Vite starts.
# Don't override them with a shell VITE_* variable or apps/web/.env.local:
# Turborepo would not hash either.
VITE_FIREBASE_API_KEY=AIzaSyBLhvp2F6AN1sPa4KOJo-vp5w3R4m_3SJc
VITE_FIREBASE_AUTH_DOMAIN=storage-minis-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=storage-minis-dev
VITE_FIREBASE_APP_ID=1:267678379637:web:a7434c74b65d22a45bd23c
