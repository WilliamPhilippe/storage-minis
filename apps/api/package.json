{
  "name": "@storage-minis/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "start": "node --env-file-if-exists=../../.env.development --enable-source-maps dist/server.js",
    "test:process": "vitest run --config vitest.process.config.mts",
    "dev": "node --env-file-if-exists=../../.env.development --watch --watch-preserve-output --import tsx src/server.ts",
    "test:stack": "vitest run --config vitest.stack.config.mts"
  },
  "dependencies": {
    "@storage-minis/db": "workspace:*",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  }
}
