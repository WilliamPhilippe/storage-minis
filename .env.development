# Committed local development values (owner-approved 2026-10-31, R8/R9).
# These are not secrets: development PostgreSQL publishes only on 127.0.0.1.
# Compose reads this file only through --env-file in the local scripts;
# compose.yaml, the production images and the VPS never use it. Host Node
# processes load it with --env-file-if-exists; values already set in the real
# environment take precedence.
POSTGRES_DB=storage_minis_dev
POSTGRES_PASSWORD=d025b7c02c09d6a2e3af02a898159fd2
DB_OWNER_PASSWORD=3b011c256364df73d6acaea4d5730df1
DB_APP_PASSWORD=1eb331d693e8e41f9b7f447ce5c72f14
DATABASE_URL=postgres://storage_minis_app:1eb331d693e8e41f9b7f447ce5c72f14@127.0.0.1:5433/storage_minis_dev
MIGRATION_DATABASE_URL=postgres://storage_minis_owner:3b011c256364df73d6acaea4d5730df1@127.0.0.1:5433/storage_minis_dev
# Host Node only: the API logs error messages solely when NODE_ENV is exactly
# development (owner-approved 2026-11-01). compose.yaml and the image set
# production; the API's own default when unset is also production.
NODE_ENV=development
# The API accepts ID tokens of the development Firebase project (sign-in plan
# SI-03); compose.yaml interpolates it for every local Compose command.
FIREBASE_PROJECT_ID=storage-minis-dev
# Development bootstrap (T02 record AU-07, owner's values of 2026-11-04): the
# owner's first verified Google sign-in on a database with no Organization
# creates the administrator, this Organization (BRL) and its owner Membership.
# compose.yaml does not map these until T04.
BOOTSTRAP_OWNER_EMAIL=ctt.williamphilippe@gmail.com
BOOTSTRAP_ORGANIZATION_NAME=wipminis
BOOTSTRAP_ORGANIZATION_NICKNAME=wipminis
