{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheDir": ".turbo/cache",
  "remoteCache": {
    "enabled": false
  },
  "envMode": "strict",
  "globalDependencies": [
    ".nvmrc",
    "pnpm-workspace.yaml",
    "tsconfig*.json",
    "eslint.config.mjs",
    ".prettierrc.json",
    ".prettierignore",
    "vitest.config.mts"
  ],
  "tasks": {
    "typecheck": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "//#typecheck:root": {
      "outputs": []
    },
    "//#lint": {
      "outputs": [],
      "dependsOn": ["@storage-minis/db#build"]
    },
    "//#format:check": {
      "outputs": []
    },
    "//#test": {
      "dependsOn": ["@storage-minis/db#build"],
      "outputs": [],
      "env": ["NODE_ENV", "TZ"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@storage-minis/api#start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "NODE_ENV",
        "TZ"
      ]
    },
    "@storage-minis/db#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@storage-minis/db#db:generate": {
      "cache": false
    },
    "@storage-minis/db#db:migrate": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["MIGRATION_DATABASE_URL", "TZ"]
    },
    "@storage-minis/api#test:process": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_URL",
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "NODE_ENV",
        "TZ"
      ]
    },
    "@storage-minis/db#test:integration": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "MIGRATION_DATABASE_URL"],
      "env": ["NODE_ENV", "TZ"]
    },
    "@storage-minis/api#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "NODE_ENV",
        "TZ"
      ]
    },
    "@storage-minis/db#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
