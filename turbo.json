{
  "$schema": "https://turborepo.dev/schema.json",
  "cacheDir": ".turbo/cache",
  "remoteCache": {
    "enabled": false
  },
  "envMode": "strict",
  "globalDependencies": [
    ".nvmrc",
    "pnpm-workspace.yaml",
    "tsconfig*.json",
    "eslint.config.mjs",
    ".prettierrc.json",
    ".prettierignore",
    "vitest.config.mts"
  ],
  "tasks": {
    "typecheck": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "//#typecheck:root": {
      "outputs": []
    },
    "//#lint": {
      "outputs": [],
      "dependsOn": ["@storage-minis/db#build"]
    },
    "//#format:check": {
      "outputs": []
    },
    "//#test": {
      "dependsOn": ["@storage-minis/db#build"],
      "outputs": [],
      "env": ["NODE_ENV", "TZ"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@storage-minis/api#start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DB_TARGET",
        "PGHOST",
        "PGPORT",
        "PGDATABASE",
        "PGUSER",
        "PGPASSWORD",
        "DATABASE_URL",
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "NODE_ENV",
        "TZ"
      ]
    },
    "@storage-minis/db#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "db:check": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "DB_TARGET",
        "PGHOST",
        "PGPORT",
        "PGDATABASE",
        "PGUSER",
        "PGPASSWORD",
        "DATABASE_URL"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": [
        "DB_TARGET",
        "PGHOST",
        "PGPORT",
        "PGDATABASE",
        "PGUSER",
        "PGPASSWORD",
        "DATABASE_URL"
      ]
    },
    "test:integration": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "DB_TARGET",
        "PGHOST",
        "PGPORT",
        "PGDATABASE",
        "PGUSER",
        "PGPASSWORD",
        "DATABASE_URL"
      ],
      "env": ["NODE_ENV", "TZ"]
    }
  }
}
