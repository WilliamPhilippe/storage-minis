{
  "name": "@storage-minis/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "node -e \"for (const dir of ['dist', 'dist-testing']) require('node:fs').rmSync(dir, { recursive: true, force: true })\" && tsc --project tsconfig.build.json && tsc --project tsconfig.testing.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env.development dist/migrate.js",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist-testing/index.d.ts",
      "import": "./dist-testing/index.js"
    }
  }
}
